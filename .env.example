# Copy to .env and fill in. Only BETTER_AUTH_SECRET and BETTER_AUTH_URL are required in production.

# Signs sessions and encrypts stored SocialClaw API keys. Keep it stable once set.
# Generate one with: openssl rand -base64 32
# (The Docker image creates and persists one for you if this is empty.)
BETTER_AUTH_SECRET=

# The public URL of this app, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# SQLite file by default. For Turso or any libSQL server use libsql://... and set the token.
DATABASE_URL=file:./data/linkcliq.db
DATABASE_AUTH_TOKEN=

# Set to true after you create your account to close public sign ups.
DISABLE_SIGNUP=false

# Comma separated emails that can open /dashboard/admin to suspend pages.
ADMIN_EMAILS=

# Password reset emails. Needs a Resend API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="LinkCliq <no-reply@example.com>"

# Shows a Report link on public pages and is used as the contact address. Optional.
CONTACT_EMAIL=

# Extra origins allowed to call the auth API, comma separated (e.g. a second domain).
TRUSTED_ORIGINS=

# Origin used to build page links when your proxy does not forward the Host header.
PUBLIC_URL=

# Headers that carry the visitor's IP for sign-in rate limiting, comma separated.
# Only list headers your proxy overwrites. Railway uses x-real-ip automatically;
# behind Cloudflare use cf-connecting-ip. Default: x-forwarded-for.
IP_ADDRESS_HEADERS=

# Migrations run automatically on boot. Set to true if you run `npm run db:migrate` yourself.
SKIP_MIGRATIONS=false

# Only for the official linkcliq.com service: turns on the Terms and Privacy pages.
LINKCLIQ_CLOUD=false
